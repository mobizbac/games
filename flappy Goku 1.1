<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Goku – Fullscreen Game</title>
    <style>
        /* RESET - NO LOADING SCREEN, NO EXTRA TEXT, JUST PURE GAME */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* FULLSCREEN LAYOUT: edge-to-edge, immediate, no clutter */
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000000;
        }

        /* main wrapper fills entire viewport instantly */
        .game-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            z-index: 1;
            display: flex;
            flex-direction: column;
        }

        /* game area consumes all available space */
        .game-area {
            flex: 1;
            width: 100%;
            background: #000;
            position: relative;
        }

        #gameFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            background: #000;
        }

        /* no bottom text, no loading overlays, no extra UI elements */
        /* everything is clean and dedicated to the game */
    </style>
</head>
<body>

<div class="game-fullscreen">
    <div class="game-area">
        <iframe id="gameFrame" 
            allowfullscreen 
            sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-popups-to-escape-sandbox allow-modals allow-downloads allow-storage-access-by-user-activation"
            title="Goku"
            style="width:100%; height:100%; border:none;">
        </iframe>
    </div>
</div>

<script>
    (function() {
        // ----- ORIGINAL GAME CONTENT (Flappy Goku - SWF + WAFlash Player) -----
        // This is the exact functional HTML that loads "Goku" / Flappy Goku
        // using the same reliable resources from the original snippet.
        const GAME_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Flappy Goku</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #waflashContainer {
            width: 100%;
            height: 100%;
            position: relative;
        }
        .waflashCanvas {
            width: 100%;
            height: 100%;
            display: block;
            outline: none;
        }
    </style>
    <!-- Google Analytics (from original, kept for compatibility) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MENBM6GSNY"><\/script>
    <script>
        function gtag(){dataLayer.push(arguments);}
        window.dataLayer = window.dataLayer || [];
        gtag('js', new Date());
        gtag('config', 'G-MENBM6GSNY');
    <\/script>
</head>
<body>
    <div id="waflashContainer">
        <canvas class="waflashCanvas" id="canvas" tabindex="1"></canvas>
        <div id="waflashStatus" style="display: none;">Playing...</div>
    </div>
    <script>
        // Game configuration with the exact SWF URL from original snippet
        var gameConfig = {
            swfUrl: "https://cdn.jsdelivr.net/gh/jackilyna/wally@de4c6a9ba540d0b0dc0366fcd3387a62ae2ea124/dist/example/db-goku.swf"
        };
        
        // Mobile detection and scrolling (preserved from original)
        var is_mobile = /Mobi/i.test(window.navigator.userAgent);
        if (is_mobile) {
            function scrollToSubject() {
                try {
                    window.scrollTo({
                        top: 100,
                        left: 0,
                        behavior: 'smooth'
                    });
                } catch(e) {}
            }
            scrollToSubject();
            window.addEventListener("orientationchange", function() {
                setTimeout(scrollToSubject, 100);
            });
        } else {
            document.getElementById('canvas').focus();
        }
        
        // Prevent default keydown behavior on canvas to avoid page scrolling
        document.getElementById('canvas').addEventListener("keydown", function(ev) {
            ev.preventDefault();
            ev.stopPropagation();
        });
        
        // Focus management for canvas
        document.getElementById('canvas').addEventListener("click", function() {
            document.getElementById('canvas').focus();
        });
        
        document.addEventListener("mousedown", (function() {
            const canvasElement = document.getElementById('canvas');
            let focused = false;
            return function(ev) {
                if (ev.target == canvasElement) {
                    if (!focused) {
                        canvasElement.focus();
                        focused = true;
                    }
                } else {
                    if (focused) {
                        focused = false;
                    }
                }
                return true;
            }
        })());
        
        // Import and initialize WAFlash player (the game engine)
        import('https://cdn.jsdelivr.net/gh/zhit73/wafedit@b8543abf2881dfb9519de3f0d5022de154b7df3d/wasm/waflash-player.min.js').then(module => {
            module.createWaflash(gameConfig.swfUrl, window.wafOptions || {});
        }).catch(err => {
            console.error("WAFlash player failed to load:", err);
        });
    <\/script>
    <script type="module">
        // Additional fallback to ensure WAFlash loads correctly
        import('https://cdn.jsdelivr.net/gh/zhit73/wafedit@b8543abf2881dfb9519de3f0d5022de154b7df3d/wasm/waflash-player.min.js').then(module => {
            if (typeof module.createWaflash === 'function') {
                module.createWaflash(gameConfig.swfUrl, window.wafOptions || {});
            }
        }).catch(e => console.warn("WAFlash secondary load:", e));
    <\/script>
</body>
</html>`;

        const gameFrame = document.getElementById('gameFrame');
        
        // Function to inject the game directly using blob URL (fast, secure, no loading artifacts)
        function loadGame() {
            try {
                const blob = new Blob([GAME_HTML], { type: 'text/html' });
                const blobUrl = URL.createObjectURL(blob);
                gameFrame.src = blobUrl;
                
                // clean up blob URL after iframe loads to release memory (but keep iframe functional)
                gameFrame.onload = () => {
                    setTimeout(() => {
                        URL.revokeObjectURL(blobUrl);
                    }, 1000);
                };
            } catch (error) {
                console.warn("Blob creation fallback, using srcdoc", error);
                gameFrame.srcdoc = GAME_HTML;
            }
        }
        
        // Load game immediately – no delays, no loading screens, no extra text.
        loadGame();
        
        // (Optional but nice) Double-click anywhere on the game area to toggle browser fullscreen.
        // Does not interfere with game controls and adds convenience.
        const fullWrapper = document.querySelector('.game-fullscreen');
        if (fullWrapper) {
            fullWrapper.addEventListener('dblclick', (e) => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch(err => {
                        console.log("Fullscreen toggle (user gesture) ignored; fine.");
                    });
                } else {
                    document.exitFullscreen();
                }
            });
        }
        
        // Prevent right-click context menu inside iframe to avoid accidental interruptions.
        gameFrame.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            return false;
        });
        
        // Ensure iframe always fills the container on window resize/orientation change.
        window.addEventListener('resize', () => {
            if (gameFrame) {
                gameFrame.style.width = '100%';
                gameFrame.style.height = '100%';
            }
        });
        
        console.log("Fullscreen game active — loading screen removed, bottom credit removed, game visible instantly.");
    })();
</script>

</body>
</html>
