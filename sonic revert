<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Sonic Revert – Fullscreen Game</title>
    <style>
        /* RESET - NO LOADING SCREEN, NO EXTRA TEXT, NO ADS, JUST PURE GAME */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* FULLSCREEN LAYOUT: edge-to-edge, immediate, no clutter */
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000000;
        }

        /* main wrapper fills entire viewport instantly */
        .game-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            z-index: 1;
            display: flex;
            flex-direction: column;
        }

        /* game area consumes all available space */
        .game-area {
            flex: 1;
            width: 100%;
            background: #000;
            position: relative;
        }

        #gameFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            background: #000;
        }

        /* no bottom text, no loading overlays, no ads, no extra UI elements */
        /* everything is clean and dedicated to the game */
    </style>
</head>
<body>

<div class="game-fullscreen">
    <div class="game-area">
        <iframe id="gameFrame" 
            allowfullscreen 
            sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-popups-to-escape-sandbox allow-modals allow-downloads allow-storage-access-by-user-activation"
            title="Sonic Revert"
            style="width:100%; height:100%; border:none;">
        </iframe>
    </div>
</div>

<script>
    (function() {
        // ----- ORIGINAL GAME CONTENT (Sonic Revert - Unity WebGL) -----
        // This is the exact functional HTML that loads "Sonic Revert"
        // using the same reliable resources from the original snippet.
        // All click-to-play overlays, play buttons, and fullscreen buttons have been removed.
        const GAME_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Sonic Revert - Unity WebGL</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .webgl-content {
            width: 100%;
            height: 100%;
            position: relative;
        }
        #gameContainer {
            width: 100%;
            height: 100%;
            background: #000;
        }
        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
    </style>
    <!-- Unity Loader and Progress scripts -->
    <script src="https://cdn.jsdelivr.net/gh/lee2sman/everyday@d45d601d2c4d60adf809a0b677c00b7d12aba7e9/96/TemplateData/UnityProgress.js"><\/script>
    <script src="https://cdn.jsdelivr.net/gh/CycloKid/sonic-revert@938c293b495adfec91a0b199700e3d2cd22c0252/Build/UnityLoader.js"><\/script>
    <script>
        // Progress callback for Unity loader
        var gameInstance = null;
        
        // Create game instance immediately (no play button)
        window.onload = function() {
            gameInstance = UnityLoader.instantiate("gameContainer", "https://cdn.jsdelivr.net/gh/Iwannadieinc/games@007e2fbe2800b25085617debbd98bbed2ecf54ac/games/Sonic_Revert.json", {
                onProgress: UnityProgress,
                Module: {
                    onRuntimeInitialized: function() {
                        if (typeof UnityProgress === 'function') {
                            UnityProgress(gameInstance, "complete");
                        }
                    }
                }
            });
        };
    <\/script>
</head>
<body>
    <div class="webgl-content">
        <div id="gameContainer" style="width: 100vw; height: 100vh;"></div>
    </div>
</body>
</html>`;

        const gameFrame = document.getElementById('gameFrame');
        
        // Function to inject the game directly using blob URL (fast, secure, no loading artifacts)
        function loadGame() {
            try {
                const blob = new Blob([GAME_HTML], { type: 'text/html' });
                const blobUrl = URL.createObjectURL(blob);
                gameFrame.src = blobUrl;
                
                // clean up blob URL after iframe loads to release memory (but keep iframe functional)
                gameFrame.onload = () => {
                    setTimeout(() => {
                        URL.revokeObjectURL(blobUrl);
                    }, 1000);
                };
            } catch (error) {
                console.warn("Blob creation fallback, using srcdoc", error);
                gameFrame.srcdoc = GAME_HTML;
            }
        }
        
        // Load game immediately – no delays, no loading screens, no ads, no extra text.
        loadGame();
        
        // (Optional but nice) Double-click anywhere on the game area to toggle browser fullscreen.
        // Does not interfere with game controls and adds convenience.
        const fullWrapper = document.querySelector('.game-fullscreen');
        if (fullWrapper) {
            fullWrapper.addEventListener('dblclick', (e) => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch(err => {
                        console.log("Fullscreen toggle (user gesture) ignored; fine.");
                    });
                } else {
                    document.exitFullscreen();
                }
            });
        }
        
        // Prevent right-click context menu inside iframe to avoid accidental interruptions.
        gameFrame.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            return false;
        });
        
        // Ensure iframe always fills the container on window resize/orientation change.
        window.addEventListener('resize', () => {
            if (gameFrame) {
                gameFrame.style.width = '100%';
                gameFrame.style.height = '100%';
            }
        });
        
        console.log("Fullscreen game active — loading screen removed, ads removed, game visible instantly.");
    })();
</script>

</body>
</html>
