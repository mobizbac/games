<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Avatar Fortress Fight 2 – Fullscreen Game</title>
    <style>
     
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* FULLSCREEN LAYOUT: edge-to-edge, immediate, no clutter */
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000000;
        }

        /* main wrapper fills entire viewport instantly */
        .game-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            z-index: 1;
            display: flex;
            flex-direction: column;
        }

        /* game area consumes all available space */
        .game-area {
            flex: 1;
            width: 100%;
            background: #000;
            position: relative;
        }

        #gameFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            background: #000;
        }

        /* no bottom text, no loading overlays, no extra UI elements */
        /* everything is clean and dedicated to the game */
    </style>
</head>
<body>

<div class="game-fullscreen">
    <div class="game-area">
        <iframe id="gameFrame" 
            allowfullscreen 
            sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-popups-to-escape-sandbox allow-modals allow-downloads allow-storage-access-by-user-activation"
            title="Avatar Fortress Fight 2"
            style="width:100%; height:100%; border:none;">
        </iframe>
    </div>
</div>

<script>
    (function() {
       
        const GAME_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Avatar Fortress Fight 2 - Game</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        object, embed {
            width: 100%;
            height: 100%;
            display: block;
        }
    </style>
    <!-- Ruffle (SWF emulator) from reliable CDN -->
    <script src="https://cdn.jsdelivr.net/gh/ruffleclasssro/rf@main/ruffle.js"><\/script>
</head>
<body>
    <div style="width:100%; height:100%;">
        <object width="100%" height="100%">
            <param name="movie" value="https://cdn.jsdelivr.net/gh/funfunban/f@main/avatar-fortness-2.swf">
            <embed src="https://cdn.jsdelivr.net/gh/funfunban/f@main/avatar-fortness-2.swf" width="100%" height="100%">
        </object>
    </div>
    <script>
        // Optimize Ruffle for best experience: auto-play, remove splash screen, webgl preferred.
        if (window.RufflePlayer) {
            window.RufflePlayer.config = {
                autoplay: "on",
                unmuteOverlay: "hidden",
                letterbox: "off",
                backgroundColor: "#000000",
                splashScreen: false,
                preferredRenderer: "webgl"
            };
        }
        console.log("Avatar Fortress Fight 2 - game engine ready");
    <\/script>
</body>
</html>`;

        const gameFrame = document.getElementById('gameFrame');
        
        // Function to inject the game directly using blob URL (fast, secure, no loading artifacts)
        function loadGame() {
            try {
                const blob = new Blob([GAME_HTML], { type: 'text/html' });
                const blobUrl = URL.createObjectURL(blob);
                gameFrame.src = blobUrl;
                
                // clean up blob URL after iframe loads to release memory (but keep iframe functional)
                gameFrame.onload = () => {
                    setTimeout(() => {
                        URL.revokeObjectURL(blobUrl);
                    }, 1000);
                };
            } catch (error) {
                console.warn("Blob creation fallback, using srcdoc", error);
                gameFrame.srcdoc = GAME_HTML;
            }
        }
        
        // Load game immediately – no delays, no loading screens, no extra text.
        loadGame();
        
        // (Optional but nice) Double-click anywhere on the game area to toggle browser fullscreen.
        // Does not interfere with game controls and adds convenience.
        const fullWrapper = document.querySelector('.game-fullscreen');
        if (fullWrapper) {
            fullWrapper.addEventListener('dblclick', (e) => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch(err => {
                        console.log("Fullscreen toggle (user gesture) ignored; fine.");
                    });
                } else {
                    document.exitFullscreen();
                }
            });
        }
        
        // Prevent right-click context menu inside iframe to avoid accidental interruptions.
        gameFrame.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            return false;
        });
        
        // Ensure iframe always fills the container on window resize/orientation change.
        window.addEventListener('resize', () => {
            if (gameFrame) {
                gameFrame.style.width = '100%';
                gameFrame.style.height = '100%';
            }
        });
        
        console.log("Fullscreen game active — loading screen removed, bottom credit removed, game visible instantly.");
    })();
</script>

</body>
</html>
